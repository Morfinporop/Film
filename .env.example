# ============================================================
# Переменные окружения. На bothost задайте их в панели
# («Переменные окружения»). Файл .env в Git не попадает.
# ============================================================

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Владелец бота: полный доступ, получает звёзды (по умолчанию 7745681987)
OWNER_ID=7745681987

# Стартовые админы через запятую (необязательно)
ADMIN_IDS=

# Публичный HTTPS-адрес без слеша в конце (обязательно для webhook и Mini App)
PUBLIC_URL=

# webhook — для хостинга; polling — для локальной отладки без HTTPS
BOT_MODE=webhook

# Порт HTTP-сервера (на bothost — 3000)
PORT=3000

# Путь для входящих обновлений Telegram
WEBHOOK_PATH=/webhook

# Секрет проверки запросов от Telegram (необязательно; по умолчанию выводится из BOT_TOKEN)
WEBHOOK_SECRET=

# Файл SQLite (на bothost — /app/data/film.db). Кэш видео лежит рядом, в папке media
DB_PATH=/app/data/film.db

# Фон Mini App (необязательно; по умолчанию стандартный фон проекта)
BACKGROUND_URL=

# Цены VIP в звёздах Telegram (необязательно; по умолчанию указаны). Роли не продаются: их выдаёт владелец и админы
VIP_MONTH_PRICE=199
VIP_YEAR_PRICE=900
