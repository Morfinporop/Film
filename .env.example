# ============================================================
# Скопируйте в .env для локальной разработки.
# На bothost НЕ загружайте этот файл: задайте те же ключи
# в разделе «Переменные окружения» панели хостинга.
# ============================================================

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Telegram ID администраторов через запятую (обязательно)
ADMIN_IDS=7745681987

# Публичный HTTPS-адрес бота без слеша в конце (обязательно для webhook и Mini App)
# Пример: https://your-bot.bothost.ru
PUBLIC_URL=

# Режим: webhook (продакшн, bothost) или polling (локальная разработка без HTTPS)
BOT_MODE=webhook

# Порт HTTP-сервера (на bothost всегда 3000)
PORT=3000

# Путь для входящих обновлений Telegram
WEBHOOK_PATH=/webhook

# Секрет для проверки запросов от Telegram (необязательно: если пусто, сгенерируется из BOT_TOKEN)
# Допустимы латиница, цифры, _ и -; длина до 256 символов
WEBHOOK_SECRET=

# Путь к файлу SQLite. На bothost: /app/data/film.db
DB_PATH=/app/data/film.db
